# Godot 4+ specific ignores
.godot/
.vs/
/android/
build/
*.tmp
.vscode/
*.depren
flower_sheets/
*.dll
*.obj

# GDExtension build output. The addon's own bin/ is deliberately NOT ignored — the
# built library is committed so the addon works from a checkout — but the .dll is the
# only thing there worth keeping; the import library and the linker's leavings are not.
godot-cpp/bin/
godot-cpp/gen/
.sconsign.dblite
src/*.obj
addons/image_wrangler/bin/*.exp
addons/image_wrangler/bin/*.lib
addons/image_wrangler/bin/*.pdb

# Raw buffer dumps from the parity harness. Regenerable, and large enough that a
# baseline run of every case would dwarf the repo.
tests/dump/
