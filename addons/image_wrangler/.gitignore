*.dblite
src/*.obj
bin/*.exp
bin/*.lib
bin/~*
tests/

# Bytecode, left behind whenever Python reads tools/build_ncnn.py — running it, or merely
# importing it to check something. One of these was committed by accident once.
__pycache__/
*.pyc

# What tools/build_ncnn.py makes. Hundreds of megabytes of static library, and every byte
# of it derivable from the vendored ncnn source beside it — the built DLL in bin/ is what
# gets committed, exactly as it is for Open Image Denoise.
thirdparty/ncnn/
thirdparty/ncnn-build/
thirdparty/ncnn-shaders/

# Downloaded models, never committed. Each folder also self-ignores with its own
# .gitignore, the way thirdparty/deepbump/ does; this line is the backstop.
thirdparty/isnet-general/

# The Upscale tab's models, 78 MB between them and fetched by its Download Latest Model
# button. A folder per model, so only the folders are ignored — models/LICENSE in each is
# the models' own licence text and stays committed.
thirdparty/realesrgan-ncnn-vulkan/models/*/
thirdparty/waifu2x-ncnn-vulkan/models/*/

# The Open Image Denoise runtime, 50 MB of it in one file, fetched by the Denoise stage's
# Download Runtime button. Named one by one rather than globbed, because bin/ is also where
# the built extension lives and that is committed. See thirdparty/oidn/README-vendored.md.
bin/OpenImageDenoise.dll
bin/OpenImageDenoise_core.dll
bin/OpenImageDenoise_device_cpu.dll
bin/tbb12.dll
bin/tbbbind.dll
bin/tbbbind_2_0.dll
bin/tbbbind_2_5.dll
