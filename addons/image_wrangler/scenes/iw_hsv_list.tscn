[ext_resource type="Script" uid="uid://disidsbg5dhdp" path="res://addons/image_wrangler/ui/iw_hsv_list.gd" id="1_script"]
[ext_resource type="Script" uid="uid://dni7ui0rrppd6" path="res://addons/image_wrangler/ui/iw_entry_list.gd" id="2_list"]

[node name="HSVList" type="VBoxContainer"]
script = ExtResource("1_script")

[node name="Buttons" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="PickButton" type="Button" parent="Buttons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Drag a rectangle over the preview to add that region to the list.

Regions may overlap. They are applied in the order they were picked,
each working on what the one before it left."
toggle_mode = true
text = "Pick"

[node name="ClearButton" type="Button" parent="Buttons"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Remove every region for this image."
text = "Clear"

[node name="List" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 1
script = ExtResource("2_list")

[node name="Editor" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2

[node name="ResetButton" type="Button" parent="Editor"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Put this region's sliders back where they do nothing.
The region stays on the list."
text = "Reset Sliders"

[node name="Hint" type="Label" parent="."]
unique_name_in_owner = true
visible = false
modulate = Color(1, 1, 1, 0.6)
layout_mode = 2
autowrap_mode = 3
