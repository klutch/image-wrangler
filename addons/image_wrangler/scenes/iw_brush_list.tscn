[node name="BrushList" type="VBoxContainer"]
script = ExtResource("1_script")

[node name="Buttons" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="DrawButton" type="Button" parent="Buttons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Drag over the preview to paint a stroke. Each drag is one entry.

A click without moving puts down a single dab. Press Escape or right-click
to stop drawing."
toggle_mode = true
text = "Draw"

[node name="ClearButton" type="Button" parent="Buttons"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Remove every stroke for this image."
text = "Clear"

[node name="BrushCaption" type="Label" parent="."]
modulate = Color(1, 1, 1, 0.6)
layout_mode = 2
text = "Brush for the next stroke"
text_overrun_behavior = 3

[node name="List" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 1
script = ExtResource("2_list")

[node name="Editor" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 0

[node name="EditorCaption" type="Label" parent="Editor"]
unique_name_in_owner = true
modulate = Color(1, 1, 1, 0.6)
layout_mode = 2
text_overrun_behavior = 3

[node name="Hint" type="Label" parent="."]
unique_name_in_owner = true
visible = false
modulate = Color(1, 1, 1, 0.6)
layout_mode = 2
autowrap_mode = 3
