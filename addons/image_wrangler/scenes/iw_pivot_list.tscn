[node name="PivotList" type="VBoxContainer"]
script = ExtResource("1_script")

[node name="Buttons" type="HBoxContainer" parent="."]
layout_mode = 2

[node name="EditButton" type="Button" parent="Buttons"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Shows every sprite's pivot on the sheet, and lets one be redrawn.

Press inside a sprite to put its pivot there, then drag to aim it. Letting go
without moving leaves it facing the way it already did.

Sprites you never touch keep the middle of their rectangle facing up."
toggle_mode = true
text = "Edit"

[node name="ClearButton" type="Button" parent="Buttons"]
unique_name_in_owner = true
layout_mode = 2
tooltip_text = "Give every sprite its default pivot back."
text = "Clear"

[node name="List" type="VBoxContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 1
script = ExtResource("2_list")

[node name="Hint" type="Label" parent="."]
unique_name_in_owner = true
visible = false
modulate = Color(1, 1, 1, 0.6)
layout_mode = 2
autowrap_mode = 3
